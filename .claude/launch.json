{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cloud-sync-api",
      "runtimeExecutable": ".venv/Scripts/uvicorn.exe",
      "runtimeArgs": [
        "sync_api.main:app",
        "--app-dir",
        "cloud",
        "--host",
        "127.0.0.1",
        "--port",
        "8080"
      ],
      "port": 8080
    },
    {
      "name": "edge-a",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:DEVICE_ID='device-a'; $env:AUTHOR='Tech A'; $env:PORT='7001'; .venv/Scripts/uvicorn.exe edge.main:app --app-dir edge --host 127.0.0.1 --port 7001"
      ],
      "port": 7001
    },
    {
      "name": "edge-b",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:DEVICE_ID='device-b'; $env:AUTHOR='Tech B'; $env:PORT='7002'; .venv/Scripts/uvicorn.exe edge.main:app --app-dir edge --host 127.0.0.1 --port 7002"
      ],
      "port": 7002
    },
    {
      "name": "dashboard-a",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "dashboard",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "edge-demo-a",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:DEVICE_ID='demo-a'; $env:AUTHOR='Tech A'; $env:PORT='7001'; .venv/Scripts/uvicorn.exe edge.main:app --app-dir edge --host 127.0.0.1 --port 7001"
      ],
      "port": 7001
    }
  ]
}