{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cloud-sync-api",
      "runtimeExecutable": ".venv/Scripts/uvicorn.exe",
      "runtimeArgs": [
        "sync_api.main:app",
        "--app-dir",
        "cloud",
        "--host",
        "127.0.0.1",
        "--port",
        "8080"
      ],
      "port": 8080
    },
    {
      "name": "edge-a",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:DEVICE_ID='device-a'; $env:AUTHOR='Tech A'; $env:PORT='7001'; .venv/Scripts/uvicorn.exe edge.main:app --app-dir edge --host 127.0.0.1 --port 7001"
      ],
      "port": 7001
    },
    {
      "name": "edge-b",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:DEVICE_ID='device-b'; $env:AUTHOR='Tech B'; $env:PORT='7002'; .venv/Scripts/uvicorn.exe edge.main:app --app-dir edge --host 127.0.0.1 --port 7002"
      ],
      "port": 7002
    },
    {
      "name": "dashboard-a",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:NEXT_PUBLIC_EDGE_API='http://127.0.0.1:7001'; $env:NEXT_PUBLIC_CLOUD_API='http://127.0.0.1:8080'; npm --prefix dashboard run fast -- -p 3000"
      ],
      "port": 3000
    },
    {
      "name": "dashboard-b",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:NEXT_PUBLIC_EDGE_API='http://127.0.0.1:7002'; $env:NEXT_PUBLIC_CLOUD_API='http://127.0.0.1:8080'; $env:NEXT_DIST_DIR='.next-b'; npm --prefix dashboard run fast -- -p 3001"
      ],
      "port": 3001
    },
    {
      "name": "dashboard-a-dev",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:NEXT_PUBLIC_EDGE_API='http://127.0.0.1:7001'; $env:NEXT_PUBLIC_CLOUD_API='http://127.0.0.1:8080'; npm --prefix dashboard run dev -- -p 3000"
      ],
      "port": 3000
    },
    {
      "name": "dashboard-b-dev",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:NEXT_PUBLIC_EDGE_API='http://127.0.0.1:7002'; $env:NEXT_PUBLIC_CLOUD_API='http://127.0.0.1:8080'; $env:NEXT_DIST_DIR='.next-b'; npm --prefix dashboard run dev -- -p 3001"
      ],
      "port": 3001
    },
    {
      "name": "edge-demo-a",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:DEVICE_ID='demo-a'; $env:AUTHOR='Tech A'; $env:PORT='7001'; .venv/Scripts/uvicorn.exe edge.main:app --app-dir edge --host 127.0.0.1 --port 7001"
      ],
      "port": 7001
    }
  ]
}