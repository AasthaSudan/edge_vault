# EdgeVault cloud production secrets (copy to cloud/.env.production; never commit the copy)
# Generate keys with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# Shared secret every edge device sends as "Authorization: Bearer ..." (>= 32 chars)
FLEET_API_KEY=
# Qdrant's own API key (only the sync API uses it; Qdrant is not published)
QDRANT_API_KEY=
# Dashboard origins allowed to read the public /stats endpoint (comma-separated, no "*")
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Similarity at which a report from another device counts as corroboration
CORROBORATION_MIN_SCORE=0.88
# Host interface the API port binds to; keep 127.0.0.1 behind a reverse proxy
SYNC_API_BIND=127.0.0.1
