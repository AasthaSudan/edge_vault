# ==============================================================================
# EdgeVault Unified Environment Configuration Template
# Copy this file to .env to configure your local setup
# ==============================================================================

# --- Edge Node Configuration (Device A) ---
DEVICE_ID=device-a
AUTHOR=Tech A
DATA_ROOT=./data
PORT=7001
DENSE_MODEL=BAAI/bge-small-en-v1.5
DENSE_DIM=384
SYNC_API_URL=http://127.0.0.1:8080
# Production: SYNC_API_URL=https://<your-sync-api-host> and the fleet key the cloud was started with
FLEET_API_KEY=
# Browser origins allowed to call this edge API (the local dashboard). Never use "*":
# the edge serves PRIVATE notes and any web page could read them from localhost.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OLLAMA_MODEL=qwen2.5:1.5b
DEDUP_THRESHOLD=0.92
ROUTINE_TTL_DAYS=14

# --- Central Cloud Sync API Configuration ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
CLOUD_PORT=8080

# --- Web Dashboard Configuration ---
NEXT_PUBLIC_EDGE_API=http://127.0.0.1:7001
NEXT_PUBLIC_CLOUD_API=http://127.0.0.1:8080
DASHBOARD_PORT=3000
